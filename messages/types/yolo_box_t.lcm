package raccoon;

struct yolo_box_t
{
    int64_t timestamp;
    float   x;          // x coordinate of the box center (0.0 to 1.0, percentage of frame width)
    float   y;          // y coordinate of the box center (0.0 to 1.0, percentage of frame height)
    float   width;      // width of the box (0.0 to 1.0, percentage of frame width)
    float   height;     // height of the box (0.0 to 1.0, percentage of frame height)
    string  label;      // class label of the detected object
    float   confidence; // detection confidence score
}
