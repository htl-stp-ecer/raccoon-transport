package raccoon;

struct cam_blob_t
{
    int64_t timestamp;
    string  label;      // color label (e.g. "orange")
    float   x;          // center x (0.0 to 1.0)
    float   y;          // center y (0.0 to 1.0)
    float   width;      // bounding box width (0.0 to 1.0)
    float   height;     // bounding box height (0.0 to 1.0)
    float   area;       // contour area in pixels
    float   confidence; // detection confidence (0.0 to 1.0)
}
