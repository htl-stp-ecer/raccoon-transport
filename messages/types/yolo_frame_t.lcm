package exlcm;

struct yolo_frame_t
{
    int64_t     timestamp;
    int32_t     frame_width;    // width of the frame
    int32_t     frame_height;   // height of the frame
    int32_t     frame_size;     // size of the frame data in bytes
    byte        frame_data[frame_size]; // raw image data

    int32_t     num_boxes;      // number of detected boxes
    yolo_box_t  boxes[num_boxes]; // array of detected boxes
}